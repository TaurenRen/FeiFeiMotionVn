+function unpack(file, dir) {
+  // bsdtar is not a name that exists on Windows — but tar.exe there *is* bsdtar (without LZMA), and
+  // the bass and Erhu packs ship as .7z, so 7z.exe has to be in the list or the pack stops halfway.
+  const seven = file.toLowerCase().endsWith('.7z');
+  const cands = [
+    ...(seven ? [['7z', ['x', '-y', `-o${dir}`, file]], ['7za', ['x', '-y', `-o${dir}`, file]],
+      ['C:\\Program Files\\7-Zip\\7z.exe', ['x', '-y', `-o${dir}`, file]]] : []),
+    ['bsdtar', ['-xf', file, '-C', dir]],
+    ['tar', ['-xf', file, '-C', dir]],
+    ...(seven ? [] : [['unzip', ['-q', file, '-d', dir]]]),
+  ];
+  for (const [bin, args] of cands) {
+    const r = spawnSync(bin, args, { stdio: 'ignore' });
+    if (r.status === 0) return;
+    if (r.error && r.error.code === 'ENOENT') continue;   // not installed: try the next one
+  }
+  throw new OmError(`could not unpack ${file}\n  ${seven
+    ? 'this pack is a .7z and the tar that ships with Windows has no LZMA — install 7-Zip (free) so 7z.exe is on PATH, then run om samples build again'
+    : 'needs bsdtar, tar or unzip on PATH'}`);
+}
+
 function archive(src, cache) {
   const dir = join(cache, src.zip.split('/').pop().replace(/%2B/g, '+').replace(/\.(zip|7z)$/, ''));
   if (!existsSync(dir)) {
     const file = dir + (src.zip.endsWith('.7z') ? '.7z' : '.zip');
     if (spawnSync('curl', ['-sfL', src.zip, '-o', file]).status !== 0) throw new OmError(`could not download ${src.zip}`);
     mkdirSync(dir, { recursive: true });
-    if (spawnSync('bsdtar', ['-xf', file, '-C', dir]).status !== 0) throw new OmError(`could not unpack ${file} (needs bsdtar)`);
+    unpack(file, dir);
   }
   const files = [];
   const walk = (d) => { for (const e of readdirSync(d)) { const p = join(d, e); statSync(p).isDirectory() ? walk(p) : files.push(p); } };
